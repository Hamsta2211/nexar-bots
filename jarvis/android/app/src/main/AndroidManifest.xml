<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.RECORD_AUDIO"/>
 <uses-permission android:name="android.permission.INTERNET"/>
 <queries>
  <package android:name="com.openai.chatgpt" />
  <package android:name="com.anthropic.claude" />
  <package android:name="com.google.android.apps.bard" />
  <intent><action android:name="android.speech.RecognitionService" /></intent>
 </queries>
 <application android:theme="@style/AppTheme" android:label="Jarvis" android:usesCleartextTraffic="false" android:allowBackup="false">
  <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
