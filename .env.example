# Supabase (Render Secret)
DATABASE_URL=postgresql://nexar_app.<project-ref>:<password>@<pooler-host>:5432/postgres
APP_SECRET=<64-hex-zeichen>

# Optional: abgesicherte KDE-Connect-Brücke auf dem mit dem Samsung-Handy
# verbundenen Rechner (nicht direkt KDE Connect auf Render installieren).
KDE_CONNECT_BRIDGE_URL=https://bridge.example.invalid
KDE_CONNECT_BRIDGE_TOKEN=<long-random-token>
